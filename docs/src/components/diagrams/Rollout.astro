---
// Adopting stormbreaker, from one team alone to the organization (scenes-org.ts).
import AsciiDiagram from './AsciiDiagram.astro';
import { rollout } from './scenes-org';

interface Props {
	caption?: string;
}
const { caption = 'Each stage adds teams and changes nothing that came before. Any team can sit out at any stage, stood in for by a mock.' } = Astro.props;
---

<AsciiDiagram name="rolling it out" scene={rollout.scene} title={rollout.title} text={rollout.text} caption={caption} legend={[{ kind: 'coord', label: 'what stormbreaker adds' }, { kind: 'traffic', label: 'traffic' }, { kind: 'own', label: 'a team’s own door' }]} />
